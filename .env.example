# --- Database ---
DATABASE_URL=postgresql+psycopg://pipeline:pipeline@db:5432/pipeline

# --- arXiv ingestion ---
ARXIV_CATEGORIES=cs.AI,cs.CL,cs.LG
ARXIV_MAX_PAPERS=3000
ARXIV_PAGE_SIZE=100
ARXIV_MIN_REQUEST_INTERVAL_SECONDS=3.0

# --- Embeddings / vector store ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
FAISS_DIR=/app/data
FAISS_INDEX_NAME=papers.index

# --- Reranking ---
RERANK_ENABLED=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# --- LLM ---
# "ollama" (local, free, what I'm testing against) or "gemini".
# Add a new provider by writing app/adapters/llm_<name>.py and registering
# it in app/adapters/llm_factory.py - no other code changes needed.
LLM_PROVIDER=gemini

# Ollama runs on your host machine, not in this container, hence
# host.docker.internal (Docker Desktop resolves this on Mac/Windows; on
# Linux the docker-compose.yml extra_hosts entry makes it resolve too).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
# ^ must exactly match a tag from `ollama list` on your host - if it
#   differs (e.g. qwen2.5:4b), update this.

# Only needed if LLM_PROVIDER=gemini. Get a key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- RAG retrieval knobs ---
RETRIEVAL_TOP_K=20
RETRIEVAL_TOP_N=5
RETRIEVAL_MIN_SCORE=0.35
RAG_MAX_CONTEXT_TOKENS=3000
RAG_MAX_ATTEMPTS=2

# --- App ---
LOG_LEVEL=INFO
